# DirectorOS environment — copy to .env and fill in what you have.
# Everything here is OPTIONAL except DATABASE_URL when not using docker-compose.

# ---------------------------------------------------------------- core stack
DATABASE_URL=postgresql+psycopg://directoros:directoros@db:5432/directoros
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- storage (R2 / MinIO)
STORAGE_BACKEND=local            # local | s3
R2_ENDPOINT=http://minio:9000
R2_ACCESS_KEY_ID=directoros
R2_SECRET_ACCESS_KEY=directoros-secret
R2_BUCKET=directoros

# ---------------------------------------------------------------- guardrail identity
CONTACT_EMAIL=ops@directoros.example   # rides the descriptive ingest UA

# ---------------------------------------------------------------- perception (M2)
GLADIA_API_KEY=            # https://app.gladia.io — ASR + diarization

# ---------------------------------------------------------------- agent runtime (M2 close-out)
# Default provider: Meta Model API (Muse) — https://dev.meta.ai/docs
# (Google AI Studio stays supported but the sandbox IP is region-blocked by
# Google; api.meta.ai is reachable everywhere.)
#   LLM_API_KEY    Meta Model API key (prefix LLM_...; console name MODEL_API_KEY)
#   LLM_MODEL      muse-ember-1.0 = cheapest effective for tool loops
#                  ($0.10/M in, $0.004/M cached in, $0.50/M out, <=200K tier);
#                  muse-spark-1.3 for harder proposals ($1.25/$0.15/$4.25).
#                  NEVER default to *-contributor variants: cheaper, but Meta
#                  trains on your content (PII hazard for bodycam footage) —
#                  they require LLM_ALLOW_TRAINING_ON_CONTENT=1 below.
#   LLM_BUDGET_USD hard cap against the persistent spend ledger
#                  (output/llm_spend.jsonl); calls are refused BEFORE the HTTP
#                  request once cumulative spend reaches the cap.
# Native Google AI Studio (Generative Language REST) remains behind a blank
# BASE_URL: agent_runtime/llm.py handles the Gemini 3.x REST traps for you
# (parametersJsonSchema full-JSON-Schema channel, verbatim thoughtSignature
# replay across tool turns, 401 ACCESS_TOKEN_TYPE_UNSUPPORTED -> ?key= retry).
LLM_API_KEY=               # Meta Model API key (LLM_...), or a Google AI Studio key
LLM_BASE_URL=https://api.meta.ai/v1   # blank = native Gemini REST
LLM_MODEL=muse-ember-1.0
LLM_PROVIDER=              # optional explicit provider ("meta"); auto-detected from BASE_URL
LLM_BUDGET_USD=15.0        # spend cap; the account has ~$20 of credit
LLM_SPEND_LEDGER=          # default: <OUTPUT_DIR>/llm_spend.jsonl
LLM_ALLOW_TRAINING_ON_CONTENT=   # set to 1 ONLY to opt into *-contributor models

# ---------------------------------------------------------------- vision (M4)
VISION_API_KEY=            # multimodal frame understanding (same AI Studio key works)

# ---------------------------------------------------------------- YouTube publish (M2/M5)
# Google Cloud OAuth client for the YouTube Data API v3 (privacy=private drafts).
# One-time interactive step (needs a browser — Google removed the OOB flow):
#   python scripts/gen_youtube_refresh_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- compute backend (M4)
# Which vision compute lane runs heavy jobs (faces / ASR / demucs):
#   local   -> onnxruntime on CPU, $0, zero card (DEFAULT)
#   kaggle  -> free Kaggle GPU via /api/v1/kernels/push (zero card, batch latency)
#   modal   -> dormant; requires a payment method (verification fee) — leave empty
COMPUTE_BACKEND=local

# Kaggle free GPU lane (COMPUTE_BACKEND=kaggle). KAGGLE_KEY is a KGAT_ token
# created at kaggle.com/settings → API → Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------- Modal GPU (M4)
# Kept for future optional use. NOTE: we do NOT attach a payment method to Modal
# (their card verification charges a fee). Leave blank unless that changes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------- TTS providers
# edge-tts is the $0 default and needs no key. Set ELEVENLABS_API_KEY to switch
# narration to ElevenLabs (with-timestamps endpoint) — config, not code.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------- web UI (M3)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------------------------------------------------------------- audio: 2-Bus Speech Isolation (M4)
# AUDIO_MODE selects the raw-clip audio law:
#   loudnorm_48k -> legacy integrated loudnorm (hermetic default)
#   isolate_2bus -> broadcast 2-bus speech isolation (production bodycam law):
#     neural enhancer -> intelligibility EQ+comp -> speech-gated -14 dB duck ->
#     tamed ambience bed (-24 dB, 150 Hz-4 kHz) -> speech-gated gain ->
#     -1.5 dBTP limiter -> 48 kHz stereo + quantitative SNR QA gates
AUDIO_MODE=

# AUDIO_ENHANCER selects the Bus-1 neural speech extractor:
#   auto        -> clearervoice if importable, else deep-filter, else HARD FAIL
#                  (never silently afftdn)
#   deepfilter  -> deep-filter Rust CLI (DeepFilterNet3, model embedded in the
#                  release binary; installed in apps/worker/Dockerfile)
#   clearervoice-> ClearerVoice MossFormer2_SE_48K (needs the clearvoice package)
#   afftdn      -> weak ffmpeg FFT denoiser; EXPLICIT only — production runs
#                  fail the enhancer_engine_used QA gate outside hermetic tests
AUDIO_ENHANCER=auto

# DEEPFILTER_BIN overrides the binary path (default: `deep-filter` on PATH)
DEEPFILTER_BIN=

# DIRECTOR_OS_ALLOW_AFFTDN=1 marks a hermetic-test environment; production
# never sets this (afftdn-cleaned audio cannot ship quietly).
DIRECTOR_OS_ALLOW_AFFTDN=
