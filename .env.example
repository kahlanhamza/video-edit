# DirectorOS environment — copy to .env and fill in what you have.
# Everything here is OPTIONAL except DATABASE_URL when not using docker-compose.

# ---------------------------------------------------------------- core stack
DATABASE_URL=postgresql+psycopg://directoros:directoros@db:5432/directoros
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- storage (R2 / MinIO)
STORAGE_BACKEND=local            # local | s3
R2_ENDPOINT=http://minio:9000
R2_ACCESS_KEY_ID=directoros
R2_SECRET_ACCESS_KEY=directoros-secret
R2_BUCKET=directoros

# ---------------------------------------------------------------- guardrail identity
CONTACT_EMAIL=ops@directoros.example   # rides the descriptive ingest UA

# ---------------------------------------------------------------- perception (M2)
GLADIA_API_KEY=            # https://app.gladia.io — ASR + diarization

# ---------------------------------------------------------------- agent runtime (M2 close-out)
# One OpenAI-compatible endpoint for the Pydantic AI Director backend.
LLM_API_KEY=               # pending — paste in chat when ready
LLM_BASE_URL=              # e.g. https://api.openai.com/v1 or a local vLLM
LLM_MODEL=                 # e.g. gpt-4.1 / glm-4.6

# ---------------------------------------------------------------- vision (M4)
VISION_API_KEY=            # multimodal frame understanding (GLM-4V etc.)

# ---------------------------------------------------------------- YouTube publish (M2/M5)
# Google Cloud OAuth client for the YouTube Data API v3 (privacy=private drafts).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- Modal GPU (M4)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------- web UI (M3)
NEXT_PUBLIC_API_BASE=http://localhost:8000
