# DirectorOS environment — copy to .env and fill in what you have.
# Everything here is OPTIONAL except DATABASE_URL when not using docker-compose.

# ---------------------------------------------------------------- core stack
DATABASE_URL=postgresql+psycopg://directoros:directoros@db:5432/directoros
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- storage (R2 / MinIO)
STORAGE_BACKEND=local            # local | s3
R2_ENDPOINT=http://minio:9000
R2_ACCESS_KEY_ID=directoros
R2_SECRET_ACCESS_KEY=directoros-secret
R2_BUCKET=directoros

# ---------------------------------------------------------------- guardrail identity
CONTACT_EMAIL=ops@directoros.example   # rides the descriptive ingest UA

# ---------------------------------------------------------------- perception (M2)
GLADIA_API_KEY=            # https://app.gladia.io — ASR + diarization

# ---------------------------------------------------------------- agent runtime (M2 close-out)
# Native Google AI Studio (Generative Language REST) or any OpenAI-compatible gateway.
# Blank BASE_URL = native Gemini REST; agent_runtime/llm.py handles the Gemini 3.x
# REST traps for you (parametersJsonSchema full-JSON-Schema channel, verbatim
# thoughtSignature replay across tool turns, 401 ACCESS_TOKEN_TYPE_UNSUPPORTED
# -> ?key= retry). Ops note: if you RESTRICT the key in Cloud Console, allow the
# "Generative Language API" (NOT the "Gemini API" entry — known dropdown trap).
LLM_API_KEY=               # Google AI Studio key (native Gemini when BASE_URL blank)
LLM_BASE_URL=              # blank = native Gemini SDK; or e.g. https://gw.example/v1
LLM_MODEL=                 # e.g. gemini-3.8-flash / glm-4.6 (pick a model your key can see)

# ---------------------------------------------------------------- vision (M4)
VISION_API_KEY=            # multimodal frame understanding (same AI Studio key works)
# Two-tier Gemini stack (perception/vision_index.py): the LITE model builds the
# visual timeline from 3x3 contact sheets (pennies), the FLAGSHIP model runs
# Frames-on-Demand QA (card/zoom placement vs faces + the AXON overlay).
# 2.5-flash deprecates 2026-12-01 — defaults below are the current fast tiers.
VISION_INDEX_MODEL=gemini-3.5-flash-lite
VISION_QA_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------- YouTube publish (M2/M5)
# Google Cloud OAuth client for the YouTube Data API v3 (privacy=private drafts).
# One-time interactive step (needs a browser — Google removed the OOB flow):
#   python scripts/gen_youtube_refresh_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- Modal GPU (M4)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------- web UI (M3)
NEXT_PUBLIC_API_BASE=http://localhost:8000
