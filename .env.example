# DirectorOS environment — copy to .env and fill in what you have.
#
#   cp .env.example .env      (or just run ./setup.sh — it does this for you)
#
# THE EASY PATH: the only two keys worth pasting are below. Everything else
# is optional and the stack boots and renders without any of them.
#
# Inside docker compose, the service URLs below are OVERRIDDEN automatically
# (db/redis/minio internal hostnames + s3 storage) — so the SAME .env works
# for host-side `make api` too. You only ever edit keys, never URLs.

# ================================================================ START HERE
# The ONLY block you normally edit.
# ---------------------------------------------------------------------------

# 1) Transcription (ASR + diarization). Free tier at https://app.gladia.io.
#    Without it the pipeline still runs, but there are no captions/ASR.
GLADIA_API_KEY=

# 2) The AI editor's brain (LLM). Two supported ways:
#      a) Meta Model API key (LLM_... prefix) — https://fai.meta.com/developer
#         (default below: muse-ember-1.0, cheapest for tool loops)
#      b) Google AI Studio key — https://aistudio.google.com/apikey
#         then set LLM_BASE_URL= (blank) and LLM_MODEL=gemini-3.8-flash
#    Without it the pipeline falls back to a deterministic documentary cut
#    (still a real edit, just not LLM-planned).
LLM_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-ember-1.0

# ================================================================ CORE STACK
# Leave these as-is: docker compose overrides them internally, and on the
# host they point at the ports compose exposes. You never need to touch them.
DATABASE_URL=postgresql+psycopg://directoros:directoros@localhost:5432/directoros
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local            # local | s3 (compose forces s3+minio internally)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=directoros
R2_SECRET_ACCESS_KEY=directoros-secret
R2_BUCKET=directoros

CONTACT_EMAIL=ops@directoros.example   # rides the descriptive ingest UA

# ================================================================ OPTIONAL
# Vision LLM for frame understanding (same key as LLM if Google AI Studio).
VISION_API_KEY=

# Hard spend cap against the persistent ledger (output/llm_spend.jsonl);
# calls are refused BEFORE the HTTP request once the cap is reached.
LLM_BUDGET_USD=15.0

# YouTube publish (privacy=private drafts). Needs a ONE-TIME interactive
# OAuth consent on any machine with a browser:
#   python scripts/gen_youtube_refresh_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Compute backend for heavy vision jobs:
#   local   -> onnxruntime on CPU, $0, zero card (DEFAULT)
#   kaggle  -> free Kaggle GPU (KGAT_ token from kaggle.com/settings -> API)
#   modal   -> needs a payment method (leave empty)
COMPUTE_BACKEND=local
KAGGLE_USERNAME=
KAGGLE_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# TTS: edge-tts is the $0 default, no key. Optional studio-grade narration:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenRouter secondary tier (free models) — optional extra LLM fallback:
OPENROUTER_API_KEY=

# Web UI -> API base (baked into the compose web image; default is correct
# for testing on your own computer).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ================================================================ AUDIO LAWS
# AUDIO_MODE: loudnorm_48k (default) | isolate_2bus (broadcast 2-bus speech
# isolation for production bodycam work: neural enhancer -> intelligibility
# EQ+comp -> speech-gated duck -> ambience bed -> limiter -> SNR QA gates).
AUDIO_MODE=

# AUDIO_ENHANCER (Bus-1 neural speech extractor):
#   auto         -> clearervoice if importable, else deep-filter, else FAIL
#   deepfilter   -> DeepFilterNet3 CLI (embedded model; in apps/worker image)
#   clearervoice -> MossFormer2_SE_48K (needs the clearvoice package)
#   afftdn       -> weak ffmpeg denoiser; EXPLICIT only (never ships quietly)
AUDIO_ENHANCER=auto
DEEPFILTER_BIN=

# LLM provider safety valves:
#   LLM_ALLOW_TRAINING_ON_CONTENT=1  ONLY for *-contributor variants
#   (cheaper, but Meta trains on your content — a PII hazard for bodycam).
LLM_ALLOW_TRAINING_ON_CONTENT=
LLM_SPEND_LEDGER=
LLM_PROVIDER=
