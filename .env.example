# DirectorOS runtime configuration (copy to .env)

# --- persistence
DATABASE_URL=postgresql+psycopg://directoros:directoros@localhost:5432/directoros
REDIS_URL=redis://localhost:6379/0

# --- storage: local (dev sandbox) or s3 (R2 / MinIO)
STORAGE_BACKEND=local
OUTPUT_DIR=./output

# --- S3 / Cloudflare R2 (used when STORAGE_BACKEND=s3)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=directoros

# --- audio law (PLAN guardrail 1) — do not change without an ADR
TARGET_LUFS=-16.0
SAMPLE_RATE=48000
CHANNELS=2

# --- ingest identity (PLAN guardrail 3)
CONTACT_EMAIL=ops@directoros.example
